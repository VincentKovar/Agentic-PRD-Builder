# Copy to .env.local and add your key. Never commit .env.local.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-sonnet-5-5)
# ANTHROPIC_MODEL=

# Optional: enables web research (https://www.tavily.com/)
TAVILY_API_KEY=

# Optional: academic search. OpenAlex works without a key (small shared daily budget).
# A free key gives you your own: https://openalex.org/settings/api
OPENALEX_API_KEY=
# Optional: Semantic Scholar keyword search. The keyless pool is shared and often rate-limited.
# Request a free key: https://www.semanticscholar.org/product/api#api-key-form
SEMANTIC_SCHOLAR_API_KEY=
